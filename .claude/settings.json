{
  "permissions": {
    "allow": [
      "Bash(gh repo view:*)",
      "Bash(command -v:*)",
      "Bash(pnpm release:*)",
      "Bash(npm whoami:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run view:*)",
      "Bash(pnpm build:*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_close"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec block-no-verify"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec block-no-verify"
          }
        ]
      }
    ]
  }
}
